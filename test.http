#############################################
### AUTH TESTS
### Register a user
POST http://localhost:5000/api/register
Content-Type: application/json

{
  "name": "Admin Zee",
  "email": "admin@example.com",
  "password": "secret123",
  "isAdmin": true
}


### Login
POST http://localhost:5000/api/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "secret123"
}

### Get profile (replace <TOKEN> with real JWT from login)
GET http://localhost:5000/api/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJfaWQiOiI2ODlmMTBhYzMyNzkxOGMwMGQxZjRhZjAiLCJpc0FkbWluIjp0cnVlLCJpYXQiOjE3NTUyNTY1NDUsImV4cCI6MTc1NTM0Mjk0NX0.VVXSp5DGbTN8ShMZo1qC13eqD6yJxKCsO8LTWoAiVpU


#############################################
### PRODUCTS API TESTS

### Create Product (Admin only)
POST http://localhost:5000/api/products
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJfaWQiOiI2ODlmMTBhYzMyNzkxOGMwMGQxZjRhZjAiLCJpc0FkbWluIjp0cnVlLCJpYXQiOjE3NTU1MTU5NDQsImV4cCI6MTc1NTYwMjM0NH0.4sxvWyZ61ciH6-6Ma98H8ruuWPnmQB8cFjA9_Andvv0

{
  "name": "Sample Product",
  "description": "This is a test product",
  "price": 19.99,
  "category": "Electronics",
  "stock": 50,
  "imageUrl": "https://example.com/image.jpg"
}

### Get All Products (Public)
GET http://localhost:5000/api/products

### Get Single Product by ID (Public)
GET http://localhost:5000/api/products/<PRODUCT_ID>

### Update Product (Admin only)
PUT http://localhost:5000/api/products/<PRODUCT_ID>
Content-Type: application/json
Authorization: Bearer <ADMIN_TOKEN>

{
  "name": "Updated Product Name",
  "price": 29.99,
  "stock": 30
}

### Delete Product (Admin only)
DELETE http://localhost:5000/api/products/<PRODUCT_ID>
Authorization: Bearer <ADMIN_TOKEN>


#############################################
### CART API TESTS

### Get user cart
GET http://localhost:5000/api/cart
Authorization: Bearer <USER_TOKEN>

### Add item to cart
POST http://localhost:5000/api/cart/add
Content-Type: application/json
Authorization: Bearer <USER_TOKEN>

{
  "productId": "<PRODUCT_ID>",
  "quantity": 2
}

### Remove item from cart (by productId)
DELETE http://localhost:5000/api/cart/remove/<PRODUCT_ID>
Authorization: Bearer <USER_TOKEN>



#############################################
### ORDER API TESTS

### Checkout (creates new order from current cart)
POST http://localhost:5000/api/orders/checkout
Authorization: Bearer <USER_TOKEN>

### Get all orders for the logged-in user
GET http://localhost:5000/api/orders
Authorization: Bearer <USER_TOKEN>
